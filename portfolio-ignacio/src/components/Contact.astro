---
/**
 * Contact.astro — Sección de Contacto y Footer
 *
 * Para cambiar los datos de contacto: modifica el array `contactMethods`
 * y los links sociales en `socialLinks`.
 */

const contactMethods = [
  {
    label: "Email",
    value: "tu@email.com", // ← Reemplaza
    href: "mailto:tu@email.com",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  },
  {
    label: "LinkedIn",
    value: "/in/tu-perfil", // ← Reemplaza
    href: "https://linkedin.com/in/tu-perfil",
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: "GitHub",
    value: "github.com/tu-usuario", // ← Reemplaza
    href: "https://github.com/tu-usuario",
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
  },
];
---

<!-- ═══════════════════════════════════════════════════════════
     CONTACT SECTION + FOOTER
     ═══════════════════════════════════════════════════════════ -->
<section
  id="contacto"
  class="relative py-24 lg:py-32 px-6 border-t border-zinc-800/50"
>
  <div class="max-w-6xl mx-auto">
    <!-- Encabezado -->
    <div class="max-w-2xl mb-16">
      <div class="flex items-center gap-3 mb-4 animate-on-scroll">
        <span class="font-mono text-xs text-teal-400 tracking-[0.2em] uppercase">
          04 / Contacto
        </span>
        <div class="w-12 h-px bg-zinc-800"></div>
      </div>

      <h2
        class="font-syne font-bold text-3xl sm:text-4xl lg:text-5xl text-slate-100 leading-tight mb-6 animate-on-scroll"
        data-delay="80"
      >
        ¿Tienes un proyecto<br />
        en mente? <span class="text-teal-400">Hablemos.</span>
      </h2>

      <p
        class="text-slate-400 text-lg leading-relaxed animate-on-scroll"
        data-delay="150"
      >
        Estoy disponible para proyectos freelance, colaboraciones o simplemente
        para conectar. No dudes en escribirme.
      </p>
    </div>

    <!-- Grid: CTA principal / Métodos de contacto -->
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- ── CTA de email destacado ──────────────────────── -->
      <div class="animate-on-scroll" data-delay="200">
        <a
          href="mailto:tu@email.com"
          class="group block border border-zinc-800 bg-zinc-900/30 hover:bg-zinc-900/60 hover:border-teal-500/30 p-8 transition-all duration-400"
        >
          <div
            class="w-12 h-12 border border-zinc-700 group-hover:border-teal-500/50 flex items-center justify-center text-teal-400 mb-6 transition-colors duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>

          <h3 class="font-syne font-semibold text-slate-100 text-xl mb-2">
            Envíame un correo
          </h3>
          <p class="text-zinc-500 text-sm mb-4">
            La forma más directa de contactarme.
          </p>
          <div
            class="flex items-center gap-2 font-mono text-sm text-teal-400 group-hover:gap-3 transition-all duration-300"
          >
            tu@email.com
            <svg
              class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>
      </div>

      <!-- ── Lista de métodos de contacto ───────────────── -->
      <div class="space-y-4 animate-on-scroll" data-delay="280">
        {
          contactMethods.map((method, index) => (
            <a
              href={method.href}
              target={method.href.startsWith("http") ? "_blank" : undefined}
              rel={
                method.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="group flex items-center gap-4 border border-zinc-800 bg-zinc-900/20 hover:bg-zinc-900/50 hover:border-zinc-700 px-5 py-4 transition-all duration-300"
              data-delay={index * 80}
            >
              <div class="text-zinc-500 group-hover:text-teal-400 transition-colors duration-300 flex-shrink-0" set:html={method.icon} />
              <div class="flex-1 min-w-0">
                <p class="font-mono text-xs text-zinc-600 uppercase tracking-wider mb-0.5">
                  {method.label}
                </p>
                <p class="text-sm text-slate-400 group-hover:text-slate-300 transition-colors truncate">
                  {method.value}
                </p>
              </div>
              <svg
                class="w-4 h-4 text-zinc-700 group-hover:text-teal-400 group-hover:translate-x-0.5 transition-all duration-300 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- ─── FOOTER ──────────────────────────────────────────────── -->
<footer class="border-t border-zinc-800/50 py-8 px-6">
  <div
    class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <p class="font-mono text-xs text-zinc-600">
      © {new Date().getFullYear()} Ignacio Anabalón Gutiérrez — Diseñado y construido
      con
      <span class="text-teal-600">Astro</span> y
      <span class="text-teal-600">Tailwind CSS</span>.
    </p>

    <!-- Botón "volver arriba" -->
    <a
      href="#hero"
      class="group flex items-center gap-2 font-mono text-xs text-zinc-600 hover:text-teal-400 transition-colors duration-300"
    >
      Volver arriba
      <svg
        class="w-3 h-3 transition-transform duration-300 group-hover:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </a>
  </div>
</footer>
