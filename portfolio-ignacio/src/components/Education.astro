---
/**
 * Education.astro — Sección "Sobre mí" y Educación
 *
 * Para añadir más estudios: agrega un objeto al array `education`.
 * Para cambiar el texto de presentación: edita el bloque de párrafos.
 */

interface EducationItem {
  degree: string;
  institution: string;
  period: string;
  description: string;
  current?: boolean;
}

const education: EducationItem[] = [
  {
    degree: "Ingeniería Informática",
    institution: "DuocUC",
    period: "03/2026 — Actualidad",
    description:
      "Formación como Técnico Superior en Informática, con foco en desarrollo de software y sistemas. Cursando actualmente.",
    current: true,
  },
  {
    degree: "Técnico en Programación",
    institution: "Liceo Comercial Joaquín Vera Morales",
    period: "2021 — 2024",
    description:
      "Formación en programación, bases de datos y desarrollo web. Base técnica sólida para el desarrollo de software.",
    current: false,
  },
];
---

<!-- ═══════════════════════════════════════════════════════════
     EDUCATION / SOBRE MÍ SECTION
     ═══════════════════════════════════════════════════════════ -->
<section
  id="sobre-mi"
  class="relative py-24 lg:py-32 px-6 border-t border-zinc-800/50"
>
  <div class="max-w-6xl mx-auto">
    <!-- Grid: Texto izquierda / Educación derecha -->
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

      <!-- ── Columna izquierda: Sobre Mí ─────────────────── -->
      <div>
        <!-- Encabezado de sección -->
        <div class="flex items-center gap-3 mb-4 animate-on-scroll">
          <span class="font-mono text-xs text-teal-400 tracking-[0.2em] uppercase">
            01 / Sobre mí
          </span>
          <div class="flex-1 h-px bg-zinc-800"></div>
        </div>

        <h2
          class="font-syne font-bold text-3xl sm:text-4xl text-slate-100 mb-8 leading-tight animate-on-scroll"
          data-delay="80"
        >
          Construyendo el futuro,<br />
          <span class="text-teal-400">una línea a la vez.</span>
        </h2>

        <div class="space-y-4 text-slate-400 leading-relaxed animate-on-scroll" data-delay="150">
          <p>
            Soy <span class="text-slate-200 font-medium">Ignacio Anabalón Gutiérrez</span>,
            desarrollador web y estudiante de Ingeniería Informática en DuocUC,
            con base en Chile.
          </p>
          <p>
            Me apasiona la intersección entre el diseño y el desarrollo: crear
            productos que no solo funcionen correctamente, sino que también
            se vean y se sientan <span class="text-slate-200 font-medium">
            excepcionales</span> para quien los usa.
          </p>
          <p>
            Actualmente enfocado en profundizar mis conocimientos en
            desarrollo frontend moderno, arquitecturas escalables y buenas
            prácticas de ingeniería de software.
          </p>
        </div>

        <!-- Stats rápidos -->
        <div
          class="grid grid-cols-2 gap-4 mt-10 animate-on-scroll"
          data-delay="220"
        >
          {
            [
              { value: "4+", label: "Años aprendiendo" },
              { value: "1", label: "Experiencia laboral" },
            ].map((stat) => (
              <div class="border border-zinc-800 bg-zinc-900/40 p-4">
                <div class="font-syne font-bold text-3xl text-teal-400 mb-1">
                  {stat.value}
                </div>
                <div class="font-mono text-xs text-zinc-500 uppercase tracking-wider">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ── Columna derecha: Educación ──────────────────── -->
      <div>
        <div class="flex items-center gap-3 mb-8 animate-from-right">
          <span class="font-mono text-xs text-teal-400 tracking-[0.2em] uppercase">
            Educación
          </span>
          <div class="flex-1 h-px bg-zinc-800"></div>
        </div>

        <!-- Timeline educativo -->
        <div class="relative">
          <!-- Línea vertical de la timeline -->
          <div class="absolute left-3 top-0 bottom-0 w-px bg-zinc-800"></div>

          <ul class="space-y-8">
            {
              education.map((item, index) => (
                <li
                  class="relative pl-10 animate-from-right"
                  data-delay={index * 120}
                >
                  <!-- Punto en la timeline -->
                  <div
                    class={`absolute left-0 top-1.5 w-6 h-6 rounded-full border-2 flex items-center justify-center ${
                      item.current
                        ? "border-teal-400 bg-teal-400/10"
                        : "border-zinc-600 bg-zinc-900"
                    }`}
                  >
                    {item.current && (
                      <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse" />
                    )}
                  </div>

                  <!-- Contenido de la tarjeta -->
                  <div class="bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700 p-5 transition-colors duration-300">
                    <!-- Badge de estado -->
                    {item.current && (
                      <span class="inline-block font-mono text-[10px] text-teal-400 bg-teal-400/10 border border-teal-400/20 px-2 py-0.5 mb-3 uppercase tracking-wider">
                        Cursando
                      </span>
                    )}

                    <h3 class="font-syne font-semibold text-slate-100 text-lg mb-1">
                      {item.degree}
                    </h3>

                    <p class="font-mono text-sm text-teal-400/80 mb-1">
                      {item.institution}
                    </p>

                    <p class="font-mono text-xs text-zinc-500 mb-3 tracking-wide">
                      {item.period}
                    </p>

                    <p class="text-sm text-zinc-400 leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Número decorativo -->
  <div
    class="hidden xl:block absolute right-12 bottom-12 font-syne font-extrabold text-[10rem] leading-none text-zinc-900 select-none pointer-events-none"
  >
    02
  </div>
</section>
