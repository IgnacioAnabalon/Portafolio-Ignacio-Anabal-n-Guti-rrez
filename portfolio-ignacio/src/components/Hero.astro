---

<!-- ═══════════════════════════════════════════════════════════
     HERO SECTION
     Min-height 100vh para ocupar toda la pantalla.
     Contenido centrado con diseño asimétrico y detalles gráficos.
     ═══════════════════════════════════════════════════════════ -->
<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center px-6 py-24 overflow-hidden"
>
  <!-- Elemento decorativo: línea vertical lateral -->
  <div
    class="hidden lg:block absolute left-8 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-zinc-700 to-transparent"
  >
  </div>
  <div
    class="hidden lg:block absolute right-8 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-zinc-700 to-transparent"
  >
  </div>

  <div class="max-w-4xl w-full mx-auto">
    <!-- Etiqueta decorativa superior -->
    <div
      class="flex items-center gap-3 mb-8 animate-on-scroll"
      data-delay="0"
    >
      <div class="w-8 h-px bg-teal-500"></div>
      <span class="font-mono text-xs text-teal-400 tracking-[0.2em] uppercase">
        Portafolio 2025
      </span>
    </div>

    <!-- Nombre principal -->
    <h1
      class="font-syne font-extrabold text-slate-100 leading-[1.05] tracking-tight mb-6 animate-on-scroll"
      data-delay="100"
    >
      <!-- Nombre en dos líneas para impacto visual -->
      <span class="block text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
        Ignacio Anabalón
      </span>
      <span
        class="block text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-transparent"
        style="background: linear-gradient(135deg, #14b8a6 0%, #6366f1 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >
        Gutiérrez
      </span>
    </h1>

    <!-- Titular / Rol -->
    <p
      class="font-mono text-lg sm:text-xl text-slate-400 mb-6 animate-on-scroll"
      data-delay="180"
    >
      <span class="text-teal-400">{">"}</span> Estudiante de Ingeniería Informática
      & Desarrollador Web
    </p>

    <!-- Descripción corta -->
    <p
      class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-xl mb-10 animate-on-scroll"
      data-delay="250"
    >
      Enfocado en crear soluciones web <span class="text-slate-200 font-medium"
        >modernas</span
      >, <span class="text-slate-200 font-medium">escalables</span> y con un diseño
      <span class="text-slate-200 font-medium">impecable</span>.
    </p>

    <!-- CTAs + Links sociales -->
    <div
      class="flex flex-wrap items-center gap-4 animate-on-scroll"
      data-delay="330"
    >
      <!-- CTA principal -->
      <a
        href="#experiencia"
        class="group inline-flex items-center gap-2 bg-teal-500 hover:bg-teal-400 text-zinc-950 font-syne font-semibold text-sm px-6 py-3 transition-all duration-300 hover:gap-3"
      >
        Ver mi trabajo
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>

      <!-- CTA secundario -->
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 border border-zinc-700 hover:border-teal-500/50 text-slate-300 hover:text-teal-400 font-mono text-sm px-6 py-3 transition-all duration-300"
      >
        Contacto
      </a>

      <!-- Separador -->
      <div class="hidden sm:block w-px h-8 bg-zinc-700 mx-2"></div>

      <!-- Links sociales -->
      <div class="flex items-center gap-3">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              title={link.label}
              class="text-slate-500 hover:text-teal-400 transition-colors duration-300 p-1"
              set:html={link.icon}
            />
          ))
        }
      </div>
    </div>

    <!-- Indicador de scroll -->
    <div
      class="mt-20 flex items-center gap-3 animate-on-scroll"
      data-delay="450"
    >
      <div class="flex flex-col gap-1 items-center">
        <div
          class="w-px h-8 bg-gradient-to-b from-teal-500 to-transparent animate-pulse"
        >
        </div>
      </div>
      <span class="font-mono text-xs text-zinc-600 tracking-widest uppercase">
        Scroll
      </span>
    </div>
  </div>

  <!-- Número decorativo de sección -->
  <div
    class="hidden xl:block absolute right-12 bottom-12 font-syne font-extrabold text-[10rem] leading-none text-zinc-900 select-none pointer-events-none"
  >
    01
  </div>
</section>
